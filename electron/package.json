{
  "name": "rd-summary-tool",
  "version": "1.0.0",
  "description": "Offline RD Report Summary Tool",
  "author": "Saransh Kumar",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.saransh.rdsummary",
    "productName": "RD Report Summary Tool",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": null
    }
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "vite": "^5.2.8"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.2.67"
  }
}
